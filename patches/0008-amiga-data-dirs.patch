--- a/gui/src/ocpn_app.cpp
+++ b/gui/src/ocpn_app.cpp
@@ -915,7 +915,10 @@
   wxPlatformInfo platforminfo = wxPlatformInfo::Get();
 
   wxString os_name;
-#ifndef __ANDROID__
+#if defined(__AMIGAOS3__)
+  // wx has no id for AmigaOS: asking for its name fails a debug check
+  os_name = "AmigaOS";
+#elif !defined(__ANDROID__)
   os_name = platforminfo.GetOperatingSystemIdName();
 #else
   os_name = platforminfo.GetOperatingSystemFamilyName();
--- a/model/src/base_platform.cpp
+++ b/model/src/base_platform.cpp
@@ -97,6 +97,24 @@
 
 void appendOSDirSlash(wxString* pString);
 
+#ifdef __AMIGAOS3__
+#include <proto/dos.h>
+#include <string.h>
+// The program's own drawer, as a full path ending in '/' (or ':' at the
+// root of a volume), so names can be added to it directly.
+static wxString AmigaProgramDrawer() {
+  static char buf[512];
+  if (!buf[0]) {
+    BPTR lock = GetProgramDir();
+    if (!lock || !NameFromLock(lock, (STRPTR)buf, sizeof buf - 1))
+      strcpy(buf, "PROGDIR:");
+    size_t n = strlen(buf);
+    if (n && buf[n - 1] != ':' && buf[n - 1] != '/') strcat(buf, "/");
+  }
+  return wxString(buf);
+}
+#endif
+
 BasePlatform* g_BasePlatform;
 
 #ifdef __ANDROID__
@@ -278,6 +296,10 @@
 #endif
 
     if (g_bportable) m_SData_Dir = GetHomeDir();
+#ifdef __AMIGAOS3__
+    // the data comes in the program's drawer: data/ (uidata/ inside it)
+    m_SData_Dir = AmigaProgramDrawer() + "data/";
+#endif
   }
 
   return m_SData_Dir;
@@ -362,6 +384,14 @@
 #endif
 
     if (g_bportable) m_PrivateDataDir = GetHomeDir();
+#ifdef __AMIGAOS3__
+    // settings, routes, tracks and the log: User/ in the program's drawer
+    // (not ENVARC:, which is copied to RAM at every boot)
+    if (!g_bportable) {
+      m_PrivateDataDir = AmigaProgramDrawer() + "User";
+      if (!wxDirExists(m_PrivateDataDir)) wxMkdir(m_PrivateDataDir);
+    }
+#endif
     if (m_PrivateDataDir.Last() == wxFileName::GetPathSeparator())
       m_PrivateDataDir.RemoveLast();
 
