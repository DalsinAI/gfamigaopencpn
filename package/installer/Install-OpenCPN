; $VER: Install-OpenCPN 5.14.2-amiga.2 (7.11.2026)
; The Amiga Installer script for OpenCPN, an AmiCradle game port.
; Made by amicradle scripts/port_installer.py: change the spec, not this file.
; Run it from its icon, beside the OpenCPN drawer where the archive was unpacked.

(set @app-name "OpenCPN")
(set #version "5.14.2-amiga.2")
(set #drawer "OpenCPN")
(set #program "OpenCPN")
(set #space 97657)  ; KB

(onerror
    (message (cat "OpenCPN was not installed completely." "\n\n" @error-msg
                  "\n\nFiles already copied stay where they are. Run Install-OpenCPN again to finish.")))

; the Installer, the CPU and the FPU
(if (< @installer-version 2818051)
    (abort "OpenCPN needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "OpenCPN needs a 68040, 68060 or 68080. This Amiga has a " #cpu ".")))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The OpenCPN drawer is not beside Install-OpenCPN. Unpack the whole archive, then run Install-OpenCPN from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The OpenCPN drawer has no OpenCPN in it. Unpack the whole archive again."))

(welcome "This installs OpenCPN 5.14.2-amiga.2 for AmigaOS 3.2 on a 68040, 68060 or 68080.")

; where: the parent drawer
(set #default
    (if (= (exists "Work:" (noreq)) 2) "Work:"
        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the OpenCPN drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called OpenCPN in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": OpenCPN needs 100 MB free.")))

; the drawer: everything in it, but what the player has made
(set #kept "")
(if (exists (tackon #dest "User") (noreq))
    (set #kept (if (= #kept "") "User" (cat #kept "|" "User"))))
(if (not #update)
    (makedir #dest))
(if (= #kept "")
    (copyfiles
        (prompt "Copying OpenCPN")
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (all)
        (optional "force" "askuser"))
    (copyfiles
        (prompt (cat "Updating OpenCPN. Kept as they are: " #kept))
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (pattern (cat "~(" #kept ")"))
        (optional "force" "askuser")))
(if (<> (exists (tackon #parent "OpenCPN.info") (noreq)) 1)
    (copyfiles
        (help @copyfiles-help)
        (source #source)
        (dest #parent)
        (choices "OpenCPN.info")))

(set @default-dest #dest)
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. OpenCPN would have gone in " #dest "."))
    (message (cat "OpenCPN 5.14.2-amiga.2 is installed in " #dest "."
                  "\n\nTo start it, open the OpenCPN drawer and double-click the OpenCPN icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept ".")))))
(exit (quiet))
